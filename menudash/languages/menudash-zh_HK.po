msgstr "在菜單下方顯示清單"

#: includes/origin.php:334
msgid "Save origin"
msgstr "儲存產地"

#: includes/origin.php:338
msgid "On the site (DE)"
msgstr "網站上的顯示（DE）"

#: includes/icons.php:27
msgid "Recommended"
msgstr "推薦"

#: includes/icons.php:28
msgid "Spicy"
msgstr "辣"

#: includes/icons.php:29
