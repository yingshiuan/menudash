#: includes/icons.php:78
#, php-format
msgid "%1$s: %2$s"
msgstr "%1$s：%2$s"

#. translators: %s: file name.
#: includes/icons.php:85
#, php-format
msgid "%s is not an SVG, PNG, JPEG or WebP image."
msgstr "%s 不是 SVG、PNG、JPEG 或 WebP 圖片。"

#. translators: 1: file name, 2: width in pixels, 3: height in pixels.
#: includes/icons.php:89
#, php-format
msgid "%1$s is too large (%2$d × %3$d px); an icon needs about 96 px."
msgstr "%1$s 太大（%2$d × %3$d px）；圖示約需 96 px。"

#. translators: 1: file name, 2: the server's error message.
#: includes/icons.php:94 includes/photo-store.php:92
#, php-format
